# =============================================================================
# ARIADNE — environment configuration
# Copy to .env  →  `cp .env.example .env`
# Nothing here is required for DEMO_MODE: the app boots fully offline.
# =============================================================================

# ---- Runtime mode -----------------------------------------------------------
# DEMO_MODE=1  → deterministic providers, no network calls, seeded analysis.
#                The UI labels every such result "Demo analysis".
# DEMO_MODE=0  → real LLM / embedding / vision providers via the URLs below.
ARIADNE_ENV=development
DEMO_MODE=1
LOG_LEVEL=INFO

# ---- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# ---- Database ---------------------------------------------------------------
# SQLite (zero-infra default):
DATABASE_URL=sqlite:///./data/ariadne.db
# PostgreSQL (docker compose):
# DATABASE_URL=postgresql+psycopg://ariadne:ariadne@localhost:5432/ariadne
POSTGRES_USER=ariadne
POSTGRES_PASSWORD=ariadne
POSTGRES_DB=ariadne

# ---- Vector store -----------------------------------------------------------
# auto | pgvector | numpy
VECTOR_STORE=auto
EMBEDDING_DIM=384

# ---- Knowledge graph --------------------------------------------------------
# auto | sql | neo4j   (auto → sql unless NEO4J_URI is set)
GRAPH_STORE=auto
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=ariadne
GRAPH_MAX_DEPTH=4
GRAPH_DEFAULT_DEPTH=2

# ---- LLM (any OpenAI-compatible endpoint) -----------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---- Embeddings -------------------------------------------------------------
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---- Vision -----------------------------------------------------------------
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VISION_ENABLED=0

# ---- MCP --------------------------------------------------------------------
# TypeScript MCP server (apps/mcp-server). Python agent connects over HTTP.
# If unreachable, the API falls back to the in-process tool gateway and the
# audit trail records transport="in-process-fallback" (never silently).
MCP_ENABLED=1
MCP_TRANSPORT=streamable-http
MCP_SERVER_URL=http://localhost:8765/mcp
MCP_API_BASE_URL=http://localhost:8000
MCP_SERVER_PORT=8765

# ---- Retrieval tuning -------------------------------------------------------
RAG_TOP_K=8
RAG_RERANK_TOP_N=5
RAG_MIN_SCORE=0.05
RAG_REVISION_AWARE=1

# ---- Security ---------------------------------------------------------------
AUTH_ENABLED=1
DEFAULT_USER_ID=u_engineer_1
SECRET_KEY=change-me-in-production

# ---- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
